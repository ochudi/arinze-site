# Supabase: Project Settings -> API. The secret key never leaves the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional. The public address, for canonical URLs, the sitemap, the feed and
# social cards. On Vercel it is worked out from the project's production domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Keeps a deployment out of search engines. A site still on its
# .vercel.app address is kept out automatically.
# NOINDEX=1
